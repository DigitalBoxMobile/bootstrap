{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konsierge.com/schemas/bootstrap/manifest.v1.json",
  "title": "Konsierge bootstrap manifest v1",
  "type": "object",
  "required": [
    "schema",
    "env",
    "version",
    "issued_at",
    "expires_at",
    "base_domains",
    "health_path",
    "mirrors",
    "policy"
  ],
  "properties": {
    "schema": { "const": 1 },
    "env": { "enum": ["production", "staging"] },
    "version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "issued_at": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "base_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/hostname" }
    },
    "health_path": { "type": "string", "pattern": "^/" },
    "mirrors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^https://" }
    },
    "policy": {
      "type": "object",
      "required": ["connect_timeout_ms", "probe_interval_s", "refresh_interval_s"],
      "properties": {
        "connect_timeout_ms": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
        "probe_interval_s": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
        "refresh_interval_s": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
      },
      "additionalProperties": true
    },
    "min_app_version": {
      "type": "object",
      "required": ["ios", "android"],
      "properties": {
        "ios": { "type": "string" },
        "android": { "type": "string" }
      }
    },
    "notice": {
      "type": "object",
      "required": ["ru", "en"],
      "properties": {
        "ru": { "type": "string" },
        "en": { "type": "string" }
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "hostname": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"
    }
  }
}
